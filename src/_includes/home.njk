---
layout: base.njk
---

<dl class="status-block">
  <div class="status-row">
    <dt class="status-label">Updated</dt>
    <dd class="status-value">{{ site.lastUpdated }}</dd>
  </div>
  <div class="status-row">
    <dt class="status-label">Being</dt>
    <dd class="status-value">{{ status.being }}</dd>
  </div>
  <div class="status-row">
    <dt class="status-label">Thinking</dt>
    <dd class="status-value">{{ status.thinking }}</dd>
  </div>
  <div class="status-row">
    <dt class="status-label">Building</dt>
    <dd class="status-value">{{ status.building }}</dd>
  </div>
  <div class="status-row">
    <dt class="status-label">Reading</dt>
    <dd class="status-value">
      {% for book in status.reading %}{{ book }}{% if not loop.last %}<br>{% endif %}{% endfor %}
    </dd>
  </div>
  <div class="status-row status-row--section">
    <dt class="status-label">Writing</dt>
    <dd class="status-value status-value--list">
      {% if collections.writing and collections.writing.length > 0 %}
      <ul class="writing-list">
        {% for post in collections.writing | limit(5) %}
        <li class="writing-list__item">
          <a href="{{ post.url }}" class="writing-list__title">{{ post.data.title }}</a>
          <time class="writing-list__date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <a href="/writing/" class="home-more-link">All writing →</a>
    </dd>
  </div>
</dl>
