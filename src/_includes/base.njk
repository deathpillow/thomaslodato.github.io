<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Thomas James Lodato — product lead, builder, writer.' }}">

  <title>{% if title and title != 'Thomas Lodato' %}{{ title }} — Thomas Lodato{% else %}Thomas Lodato{% endif %}</title>

  <meta property="og:title" content="{{ title or 'Thomas Lodato' }}">
  <meta property="og:description" content="{{ description or 'Thomas James Lodato — product lead, builder, writer.' }}">
  <meta property="og:type" content="website">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;1,8..60,300;1,8..60,400&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-name">Thomas James Lodato</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/work/"
           class="nav-link{% if '/work/' in page.url %} is-active{% endif %}"
           {% if '/work/' in page.url %}aria-current="page"{% endif %}>Work</a>
        <a href="/writing/"
           class="nav-link{% if '/writing/' in page.url %} is-active{% endif %}"
           {% if '/writing/' in page.url %}aria-current="page"{% endif %}>Writing</a>
        <a href="/about/"
           class="nav-link{% if '/about/' in page.url %} is-active{% endif %}"
           {% if '/about/' in page.url %}aria-current="page"{% endif %}>About</a>
      </nav>
    </div>
  </header>

  <main class="site-main" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <span class="footer-meta">© Thomas James Lodato</span>
      <span class="footer-meta">
        <a href="https://www.linkedin.com/in/thomasjameslodato/">LinkedIn</a>
      </span>
    </div>
  </footer>
</body>
</html>
