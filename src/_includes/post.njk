---
layout: base.njk
---

<article class="post">
  <header class="post-header">
    <div class="post-header__meta">
      <time class="post-date" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if tags %}
        {% for tag in tags %}
        <a href="/writing/tags/{{ tag }}/" class="tag">{{ tag }}</a>
        {% endfor %}
      {% endif %}
    </div>
    <h1 class="post-title">{{ title }}</h1>
    {% if origin %}
    <p class="post-origin">Originally published in <em>{{ origin }}</em>.</p>
    {% endif %}
  </header>

  <hr class="post-rule">

  <div class="post-body">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <a href="/writing/" class="post-back">← All writing</a>
  </footer>
</article>
